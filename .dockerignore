# Build context exclusions — keep `docker build .` small + reproducible.
# Note: requirements-docker.lock is intentionally NOT excluded — Dockerfile needs it.
.git
.github
.venv
.env
.env.*
.ruff_cache
.pytest_cache
.mypy_cache
__pycache__
*.pyc
*.pyo
build/
dist/
opentele_ng.egg-info/

# NB: `tests/` is deliberately NOT excluded — `Dockerfile.test` copies it, and
# a build context is shared by every Dockerfile in the directory. Excluding it
# here broke `docker build -f Dockerfile.test .` (the flow CONTRIBUTING.md
# documents) from 1.2.0 until 1.3.2. The production `Dockerfile` never COPYs
# tests/, so the shipped image is unaffected either way.
docs/build/
docs/documentation/

# Local-only artifacts.
# NB: .dockerignore has NO trailing-comment support — only whole lines starting
# with `#` are comments. Patterns below must stay bare.
# `opentele` = symlink created by `pip install -e .`
opentele
# `claude/` = private session notes
claude/
node_modules/
# `site/` = mkdocs output
site/
